{
  "name": "@big-d/tracker-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "=== DEV ===": "",
    "dev": "vite --host",
    "preview": "vite preview",
    "dead:code:analyse": "knip --config ./knip.json",
    "dead:code:analyse:report": "pnpm dead:code:analyse --reporter json > knip-report.json",
    "dead:deps:analyse": "knip --config ./knip.deps.json",
    "=== BUILD ===": "",
    "api:generate": "npx openapi-typescript http://localhost:4002/swagger/json -o src/shared/api/types/generated-types.ts",
    "build": "tsc -b && vite build",
    "type:check": "tsc -b --noEmit",
    "=== CI ===": "",
    "format": "prettier \"src/**/*.{ts,tsx}\" --check",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx}\" --check",
    "lint": "pnpm format && eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "pnpm format:fix && eslint \"src/**/*.{ts,tsx}\" --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
