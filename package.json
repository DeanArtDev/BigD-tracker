{
  "name": "big-d",
  "version": "0.0.1",
  "description": "",
  "scripts": {
    "--DEPLOY--": "",
    "format:all": "turbo format",
    "format:all:fix": "turbo format:fix",
    "lint:all": "turbo lint",
    "lint:all:fix": "turbo lint:fix",
    "test:all": "turbo test",
    "deploy:to:prod": "bash ./tools/deploy-scripts/bootstrap.sh",
    "migrate:db:prod": "bash ./tools/deploy-scripts/migrate-prod-db.sh",
    "--BINDED--": "",
    "compose:prod": "docker-compose --profile prod --env-file ./.env -f docker-compose.prod.yml",
    "compose:dev": "docker-compose --profile dev --env-file ./.env.development -f docker-compose.yml",
    "compose:migrations": "docker-compose --profile migrations -f docker-compose.migrations.yml",
    "--DEV--": "",
    "api-gateway:dev": "turbo dev -F=@big-d/api-gateway...",
    "account-service:dev": "turbo dev -F=@big-d/account-service...",
    "training-service:dev": "turbo dev -F=@big-d/training-service...",
    "goal-service:dev": "turbo dev -F=@big-d/goal-service...",
    "tracker-client:dev": "turbo dev -F=@big-d/tracker-client...",
    "service-infrastucture:dev:up": "pnpm compose:dev up -d --wait",
    "service-infrastucture:dev:down": "pnpm compose:dev down",
    "--BUILD--": "",
    "compose:prod:up": "pnpm compose:prod up -d --wait",
    "compose:prod:down": "pnpm compose:prod down",
    "build:all": "turbo build",
    "--TOOLS--": "",
    "db:typegen:all": "turbo db:typegen -F=@big-d/goal-service",
    "migrate:all:dev:v2": "turbo migrate -F=@big-d/goal-service -- lts",
    "migrate:all:dev": "ts-node -r dotenv/config tools/data-base/migrator.ts dotenv_config_path=./.env.development dotenv_config_debug=true",
    "migrate:all:prod": "ts-node -r dotenv/config tools/data-base/migrator.ts dotenv_config_path=./.env dotenv_config_debug=true",
    "seed:all:dev": "dotenv -e .env.development -- turbo seed -F=@big-d/account-service && dotenv -e .env.development -- turbo seed -F=@big-d/*-service -F=!@big-d/account-service -F=!@big-d/goal-service",
    "seed:all:dev:v2": "turbo seed -F=@big-d/goal-service",
    "seed:all:prod": "dotenv -e .env -- turbo seed -F=@big-d/account-service && dotenv -e .env -- turbo seed -F=@big-d/*-service -F=!@big-d/account-service"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@big-d/database": "workspace:*",
    "@big-d/linter": "workspace:*",
    "@big-d/tsconfig": "workspace:*",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "cross-env": "^7.0.3",
    "dotenv": "catalog:",
    "dotenv-cli": "^8.0.0",
    "dotenv-expand": "^12.0.2",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "globals": "catalog:",
    "husky": "^9.1.7",
    "kysely": "catalog:",
    "prettier": "catalog:",
    "ts-loader": "catalog:",
    "ts-node": "catalog:",
    "turbo": "^2.5.3",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": "^22.15.0",
    "pnpm": "10.10.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@scarf/scarf",
      "@swc/core",
      "esbuild",
      "sharp"
    ]
  }
}
