{
  "name": "big-d",
  "version": "0.0.1",
  "description": "",
  "scripts": {
    "--DEPLOY--": "",
    "format:all": "turbo format",
    "format:all:fix": "turbo format:fix",
    "lint:all": "turbo lint",
    "lint:all:fix": "turbo lint:fix",
    "test:all": "turbo test",
    "test:e2e:all": "turbo test:e2e -F=@big-d/goal-service",
    "===============================  BINDED  ==========================": "",
    "compose:dev": "docker-compose --env-file ./.env.development -f ./docker-compose.dev.yml",
    "compose:test": "docker-compose --env-file ./.env -f ./docker-compose.yml",
    "===============================  DEV  ==========================": "",
    "api-gateway:dev": "turbo watch dev -F=@big-d/api-gateway...",
    "account-service:dev": "turbo watch dev -F=@big-d/account-service...",
    "training-service:dev": "turbo watch dev -F=@big-d/training-service...",
    "goal-service:dev": "turbo dev -F=@big-d/goal-service...",
    "goal-service:dev:watch": "turbo watch dev -F=@big-d/goal-service...",
    "tracker-client:dev": "turbo watch dev -F=@big-d/tracker-client...",
    "service-infrastructure:dev:up": "pnpm compose:dev up -d",
    "service-infrastructure:dev:down": "pnpm compose:dev down",
    "===============================  BUILD  ==========================": "",
    "docker:build:test:up": "pnpm compose:test up -d",
    "docker:build:test:down": "pnpm compose:test down",
    "build:api-gateway": "turbo build -F=@big-d/api-gateway",
    "build:services:all": "turbo build -F=@big-d/*-service",
    "build:clientes:all": "turbo build -F=@big-d/*-client",
    "===============================  TOOLS  ==========================": "",
    "migrate:all:v2": "turbo migrate -F=@big-d/goal-service -- lts",
    "migrate:all": "ts-node -r dotenv/config tools/data-base/migrator.ts dotenv_config_path=./.env.development dotenv_config_debug=true && pnpm migrate:all:v2",
    "seed:all:v2": "turbo seed -F=@big-d/goal-service",
    "seed:all": "pnpm seed:all:v2 && dotenv -e .env.development -- turbo seed -F=@big-d/account-service && dotenv -e .env.development -- turbo seed -F=@big-d/*-service -F=!@big-d/account-service -F=!@big-d/goal-service"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@big-d/database": "workspace:*",
    "@big-d/linter": "workspace:*",
    "@big-d/tsconfig": "workspace:*",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "cross-env": "^7.0.3",
    "dotenv": "catalog:",
    "dotenv-cli": "^8.0.0",
    "dotenv-expand": "^12.0.2",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "globals": "catalog:",
    "husky": "^9.1.7",
    "kysely": "catalog:",
    "prettier": "catalog:",
    "ts-loader": "catalog:",
    "ts-node": "catalog:",
    "turbo": "^2.7.4",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": "^24.13",
    "pnpm": "10.10.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@scarf/scarf",
      "@swc/core",
      "esbuild",
      "sharp"
    ]
  }
}
