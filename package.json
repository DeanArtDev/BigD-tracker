{
  "name": "big-d",
  "version": "0.0.1",
  "description": "",
  "scripts": {
    "--DEPLOY--": "",
    "format:all": "turbo format",
    "format:all:fix": "turbo format:fix",
    "lint:all": "turbo lint",
    "lint:all:fix": "turbo lint:fix",
    "deploy:to:prod": "bash ./deploy-scripts/bootstrap.sh",
    "--DEV--": "",
    "agi-gateway:dev": "turbo dev -F=@big-d/api-gateway...",
    "account-service:dev": "turbo dev -F=@big-d/account-service...",
    "training-service:dev": "turbo dev -F=@big-d/training-service...",
    "goal-service:dev": "turbo dev -F=@big-d/goal-service...",
    "tracker-client:dev": "turbo dev -F=@big-d/tracker-client...",
    "service-infrastucture:dev:up": "docker-compose --profile dev --env-file ./.env.development -f docker-compose.yml up -d --wait",
    "service-infrastucture:dev:down": "docker-compose --profile dev --env-file ./.env.development -f docker-compose.yml down",
    "--BUILD--": "",
    "compose:prod:up": "docker-compose --profile prod --env-file ./.env -f docker-compose.prod.yml up -d --wait",
    "compose:prod:down": "docker-compose --profile prod --env-file ./.env -f docker-compose.prod.yml down",
    "build:all": "turbo build",
    "--TOOLS--": "",
    "db:typegen:all": "turbo db:typegen -F=@big-d/goal-service",
    "migrate:all": "ts-node tools/migrator.ts",
    "seed:all": "turbo seed -F=@big-d/account-service && turbo seed -F=@big-d/*-service -F=!@big-d/account-service"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@big-d/linter": "workspace:*",
    "@big-d/tsconfig": "workspace:*",
    "@big-d/database": "workspace:*",
    "turbo": "^2.5.3",
    "typescript": "catalog:",
    "dotenv": "catalog:",
    "kysely": "catalog:",
    "ts-node": "catalog:",
    "ts-loader": "catalog:",
    "@types/node": "catalog:",
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:",
    "prettier": "catalog:"
  },
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": "^22.15.0",
    "pnpm": "10.10.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@scarf/scarf",
      "@swc/core",
      "esbuild",
      "sharp"
    ]
  }
}
