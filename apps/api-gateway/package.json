{
  "name": "@big-d/api-gateway",
  "version": "0.0.1",
  "description": "",
  "author": "deankorobchenko@gmail.com",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "=== DEV ===": "",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "=== RUN ===": "",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/src/main",
    "=== CI ===": "",
    "format": "prettier \"src/**/*.ts\" --check",
    "format:fix": "prettier --write \"src/**/*.ts\" --check",
    "lint": "pnpm format && eslint \"src/**/*.ts\"",
    "lint:fix": "pnpm format:fix && eslint \"src/**/*.ts\" --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@big-d/api-contracts": "workspace:*",
    "@big-d/api-utils": "workspace:*",
    "@big-d/exceptions": "workspace:*",
    "@big-d/observability": "workspace:*",
    "@nestjs/apollo": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/graphql": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/microservices": "catalog:",
    "@nestjs/passport": "catalog:",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "catalog:",
    "amqp-connection-manager": "catalog:",
    "amqplib": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "cookie-parser": "^1.4.7",
    "dataloader": "2.2.3",
    "express": "catalog:",
    "graphql": "16.14.0",
    "graphql-subscriptions": "3.0.0",
    "kysely": "catalog:",
    "passport": "^0.7.0",
    "passport-http": "^0.3.0",
    "qs": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "catalog:",
    "@faker-js/faker": "^9.8.0",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@swc/core": "^1.15.47",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "catalog:",
    "@types/jest": "^29.5.14",
    "@types/node": "catalog:",
    "@types/qs": "catalog:",
    "@types/passport": "^1.0.17",
    "@types/passport-http": "^0.3.11",
    "@types/supertest": "^6.0.2",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "globals": "catalog:",
    "jest": "^29.7.0",
    "kysely-codegen": "catalog:",
    "prettier": "catalog:",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "catalog:",
    "ts-node": "catalog:",
    "tsconfig-paths": "^4.2.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1",
      "^@db/(.*)$": "<rootDir>/../db/$1"
    }
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.18.1",
    "pnpm": "11.21.0"
  }
}
