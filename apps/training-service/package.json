{
  "name": "@big-d/training-service",
  "version": "0.0.1",
  "description": "",
  "author": "deankorobchenko@gmail.com",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "=== DEV ===": "",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "=== RUN ===": "",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/src/main",
    "=== TOOLS ===": "",
    "migrate": "ts-node tools/migrator.ts lts",
    "seed": "ts-node tools/run-seeds.ts",
    "db:typegen": "kysely-codegen --config-file .kysely-codegenrc.json",
    "=== CI ===": "",
    "format": "prettier \"src/**/*.ts\" \"db/**/*.ts\" \"tools/**/*.ts\" --check",
    "format:fix": "prettier --write \"src/**/*.ts\" \"db/**/*.ts\" \"tools/**/*.ts\" --check",
    "lint": "pnpm format && eslint \"{src,tools,db}/**/*.ts\"",
    "lint:fix": "pnpm format:fix && eslint \"{src,tools,db}/**/*.ts\" --fix",
    "test": "jest --passWithNoTests --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@big-d/api-contracts": "workspace:*",
    "@big-d/api-utils": "workspace:*",
    "@big-d/database": "workspace:*",
    "@big-d/exceptions": "workspace:*",
    "@big-d/observability": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/microservices": "catalog:",
    "amqp-connection-manager": "catalog:",
    "amqplib": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "date-fns": "catalog:",
    "kysely": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "catalog:",
    "@faker-js/faker": "^9.8.0",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@swc/core": "^1.15.47",
    "@types/jest": "^29.5.14",
    "@types/node": "catalog:",
    "@types/supertest": "^6.0.2",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "globals": "catalog:",
    "jest": "^29.7.0",
    "kysely-codegen": "catalog:",
    "prettier": "catalog:",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "catalog:",
    "ts-node": "catalog:",
    "tsconfig-paths": "^4.2.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@infrastructure/(.*)$": "<rootDir>/infrastructure/$1",
      "^@db/(.*)$": "<rootDir>/../db/$1"
    },
    "collectCoverageFrom": [
      "**/*.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.18.1",
    "pnpm": "11.21.0"
  }
}
