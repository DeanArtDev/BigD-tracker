{
  "name": "@big-d/goal-service",
  "version": "0.0.1",
  "description": "",
  "author": "deankorobchenko@gmail.com",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "=== DEV ===": "",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "=== RUN ===": "",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/src/main",
    "=== TOOLS ===": "",
    "seed": "ts-node tools/run-seeds.ts",
    "migrate": "ts-node tools/migrate.ts",
    "db:typegen": "kysely-codegen --config-file .kysely-codegenrc.json",
    "=== CI ===": "",
    "format": "prettier \"src/**/*.ts\" \"db/**/*.ts\" \"tools/**/*.ts\" --check",
    "format:fix": "prettier --write \"src/**/*.ts\" \"db/**/*.ts\" \"tools/**/*.ts\" --check",
    "lint": "pnpm format && eslint \"{src,tools,db}/**/*.ts\"",
    "lint:fix": "pnpm format:fix && eslint \"{src,tools,db}/**/*.ts\" --fix",
    "test": "jest --config jest.config.js --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@big-d/api-contracts": "workspace:*",
    "@big-d/api-utils": "workspace:*",
