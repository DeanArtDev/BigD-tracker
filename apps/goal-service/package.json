{
  "name": "@big-d/goal-service",
  "version": "0.0.1",
  "description": "",
  "author": "deankorobchenko@gmail.com",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "===================== DEV =====================": "",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "===================== PROD =====================": "",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/src/main",
    "===================== TOOLS =====================": "",
    "seed": "ts-node tools/run-seeds.ts",
    "migrate": "ts-node tools/migrate.ts",
    "migrate:lts": "ts-node tools/migrate.ts lts",
    "db:typegen": "kysely-codegen --config-file .kysely-codegenrc.json",
    "===================== CI =====================": "",
    "format": "prettier \"src/**/*.ts\" \"db/**/*.ts\" \"tools/**/*.ts\" --check",
    "format:fix": "prettier --write \"src/**/*.ts\" \"db/**/*.ts\" \"tools/**/*.ts\" --check",
    "lint": "pnpm format && eslint \"{src,tools,db}/**/*.ts\" --ignore-pattern \"src/modules/tasks/presentation/rmq/__tests__/**\"",
    "lint:fix": "pnpm format:fix && eslint \"{src,tools,db}/**/*.ts\" --fix --ignore-pattern \"src/modules/tasks/presentation/rmq/__tests__/**\"",
    "type:check": "tsc --noEmit",
    "test": "TZ=UTC jest --config jest.config.js --passWithNoTests --runInBand --no-cache",
    "test:watch": "jest --watch --runInBand --no-cache",
    "test:cov": "jest --coverage --runInBand --no-cache",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "TZ=UTC jest --config jest-e2e.config.js --passWithNoTests --runInBand --no-cache"
  },
  "dependencies": {
    "@big-d/time": "workspace:*",
    "@big-d/api-contracts": "workspace:*",
    "@big-d/observability": "workspace:*",
    "@big-d/api-utils": "workspace:*",
    "@big-d/database": "workspace:*",
    "@big-d/exceptions": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/cqrs": "catalog:",
    "@nestjs/microservices": "catalog:",
    "@nestjs/schedule": "catalog:",
    "amqp-connection-manager": "catalog:",
    "amqplib": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "express": "catalog:",
    "kysely": "catalog:",
    "lodash": "catalog:",
    "reflect-metadata": "catalog:",
    "rrule": "2.8.1",
    "rxjs": "catalog:",
    "validator": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@faker-js/faker": "^9.8.0",
    "@big-d/configs-linter": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@swc/core": "^1.15.47",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "catalog:",
    "@types/jest": "^29.5.14",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "^6.0.2",
    "@types/validator": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "jest": "^29.7.0",
    "kysely-codegen": "catalog:",
    "prettier": "catalog:",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "catalog:",
    "ts-node": "catalog:",
    "tsconfig-paths": "^4.2.0",
    "typescript": "catalog:",
    "utility-types": "^3.11.0"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.21.0"
  }
}
