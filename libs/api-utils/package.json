{
  "name": "@big-d/api-utils",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "=== DEV ===": "",
    "dev": "tsup",
    "=== BUILD ===": "",
    "build": "tsup",
    "=== LINK ===": "",
    "test": "vitest run --passWithNoTests",
    "format": "npx prettier . --check",
    "format:fix": "npx prettier . --write",
    "lint": "pnpm format && eslint \"./src/**/*.ts\"",
    "lint:fix": "pnpm format:fix && eslint \"./src/**/*.ts\" --fix"
  },
  "dependencies": {
    "@big-d/time": "workspace:*",
    "@big-d/api-contracts": "workspace:*",
    "@big-d/exceptions": "workspace:*",
    "@big-d/database": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/microservices": "catalog:",
    "class-transformer": "catalog:",
    "dayjs": "catalog:",
    "kysely": "catalog:",
    "lodash": "catalog:",
    "rxjs": "catalog:",
    "validator": "catalog:"
  },
  "devDependencies": {
    "@big-d/configs-linter": "workspace:*",
    "@eslint/js": "catalog:",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "@types/validator": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": [
    "src/time-and-date/plugins.ts"
  ],
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.21.0"
  }
}
