{
  "name": "@big-d/api-contracts",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "=== DEV ===": "",
    "dev": "tsup",
    "=== BUILD ===": "",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "=== LINK ===": "",
    "test": "echo \"Error: no test specified , just skip\" && exit 0",
    "format": "npx prettier . --check",
    "format:fix": "npx prettier . --write",
    "lint": "pnpm format && eslint \"./src/**/*.ts\"",
    "lint:fix": "pnpm format:fix && eslint \"./src/**/*.ts\" --fix"
  },
  "dependencies": {
    "@big-d/exceptions": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/microservices": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "reflect-metadata": "catalog:",
    "rrule": "2.8.1",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@big-d/configs-linter": "workspace:*",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "sideEffects": false,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.21.0"
  }
}
