{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.json", "**/.env.*local"],



  "tasks": {
    "start": {
      "dependsOn": ["build"]
    },

    "migrate": {
      "dependsOn": ["build"]
    },

    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },

    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },

    "test": {
      "dependsOn": ["^test"]
    },

    "format": {
      "dependsOn": ["^format"]
    },

    "format:fix": {
      "dependsOn": ["^format:fix"]
    },

    "lint": {
      "dependsOn": ["^lint"]
    },

    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "clean": {
      "persistent": true,
      "cache": false
    }
  }
}
