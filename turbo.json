{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.json", "**/.env.*local"],

  "tasks": {
    "start": {
      "dependsOn": ["build"]
    },

    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "interruptible": true
    },

    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["BACK_TO_BACK_URL", "PORT", "NEXT_PUBLIC_HTTP_API_URL", "NEXT_PUBLIC_WS_API_URL"]
    },

    "prod": {
      "dependsOn": ["^build"],
      "cache": false
    },

    "seed": {
      "outputs": [],
      "cache": false,
      "env": ["DB_HOST", "DB_PORT", "DB_DATABASE", "DB_USERNAME", "DB_PASSWORD"]
    },

    "migrate": {
      "outputs": [],
      "cache": false,
      "env": ["DB_HOST", "DB_PORT", "DB_DATABASE", "DB_USERNAME", "DB_PASSWORD"]
    },

    "db:typegen": {},

    "test": {},

    "test:e2e": {},

    "format": {},

    "format:fix": {},

    "lint": {},

    "lint:fix": {},

    "type:check": {}
  }
}
